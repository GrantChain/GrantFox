// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation("payouts", fields: [userId], references: [id])
  grants    Grant[]
  comments  Comment[]

  @@index([userId])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  address   String   @unique
  payouts   Payout[] @relation("payouts")
  comments  Comment[]

  @@index([createdAt])
}

model Grant {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  address       String   @unique
  totalGranted  Float    @default(0) @map("total_granted")
  grantType     String   @default("POG") @map("grant_type")
  pout        Payout   @relation(fields: [payoutId], references: [id])
  payoutId      String   @map("payout_id")
  transactionHash String @map("transaction_hash")
  recipients    GrantRecipient[]

  @@index([payoutId])
  @@index([createdAt])
}

model GrantRecipient {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  address       String   @unique
  grant         Grant    @relation(fields: [grantId], references: [id])
  grantId       String   @map("grant_id")
  percentage    Float
  amount        Float
  transactionHash String @map("transaction_hash")

  @@index([grantId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  content   String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  payoutId  String   @map("payout_id")
  payout    Payout   @relation(fields: [payoutId], references: [id])

  @@index([payoutId])
  @@index([userId])
  @@index([createdAt])
}
